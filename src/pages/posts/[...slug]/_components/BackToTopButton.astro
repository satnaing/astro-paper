---
import type { MarkdownHeading } from "astro";
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import IconListTree from "@/assets/icons/IconListTree.svg";
import IconX from "@/assets/icons/IconX.svg";
import { useTranslations } from "@/i18n";
import { buildTocTree, hasToc } from "@/utils/buildTocTree";
import TocList from "./TocList.astro";

type Props = { headings?: MarkdownHeading[] };

const { headings = [] } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const withToc = hasToc(headings);
const items = withToc ? buildTocTree(headings) : [];
---

<div id="post-fab" class="post-fab" data-pagefind-ignore>
  <button
    type="button"
    class="post-fab-btn"
    aria-label={withToc ? t.post.tableOfContents : t.post.backToTop}
    popovertarget={withToc ? "toc-popover" : undefined}
    data-has-toc={withToc ? "" : undefined}
  >
    <span class="post-fab-progress" aria-hidden="true"></span>
    {
      withToc && (
        <>
          <IconListTree class="post-fab-icon-toc size-6" aria-hidden="true" />
          <IconX class="post-fab-icon-close size-6" aria-hidden="true" />
        </>
      )
    }
    <IconArrowNarrowUp class="post-fab-icon-top size-6" aria-hidden="true" />
  </button>
</div>

{
  withToc && (
    <div id="toc-popover" class="toc-popover" popover data-pagefind-ignore>
      <nav aria-labelledby="toc-popover-label" data-toc-nav>
        <h2 id="toc-popover-label" class="toc-label">
          {t.post.tableOfContents}
        </h2>
        <TocList {items} />
        <button type="button" class="toc-back-to-top" data-back-to-top>
          <IconArrowNarrowUp class="size-4" aria-hidden="true" />
          {t.post.backToTop}
        </button>
      </nav>
    </div>
  )
}

<script>
  let cleanup: (() => void) | undefined;

  function initPostFab() {
    cleanup?.();
    cleanup = undefined;

    const root = document.documentElement;
    const fab = document.getElementById("post-fab");
    const button = fab?.querySelector<HTMLButtonElement>("button");
    const progress = fab?.querySelector<HTMLElement>(".post-fab-progress");
    const popover = document.getElementById("toc-popover");
    const sideToc = document.querySelector<HTMLElement>(".toc-side > nav");
    if (!fab || !button || !progress) return;

    const scrollToTop = () => {
      root.scrollTop = 0;
      document.body.scrollTop = 0;
    };
    const opensToc = button.hasAttribute("data-has-toc");

    const onButtonClick = () => {
      if (!opensToc) scrollToTop();
    };

    const closePopover = () => {
      if (popover?.matches(":popover-open")) popover.hidePopover();
    };
    const onDocClick = (e: Event) => {
      const target = e.target as Element;
      if (target.closest("[data-back-to-top]")) {
        scrollToTop();
        closePopover();
      } else if (target.closest(".toc-popover a")) {
        closePopover();
      }
    };

    // The scroll spy can't scroll a hidden popover, so catch up on open.
    const onToggle = (e: Event) => {
      const list = popover?.querySelector<HTMLElement>("nav > ol");
      if ((e as ToggleEvent).newState !== "open" || !list) return;
      const active = list.querySelector<HTMLElement>("[aria-current]");
      if (active && list.scrollHeight > list.clientHeight) {
        list.scrollTop = active.offsetTop - list.clientHeight / 2;
      }
    };

    let lastVisible: boolean | null = null;
    let frame = 0;
    function update() {
      frame = 0;
      // CSS hides a side TOC with no room, but can't tell the button from there.
      fab!.toggleAttribute("data-side-toc-hidden", sideToc?.offsetWidth === 0);

      const scrollTotal = root.scrollHeight - root.clientHeight;
      const ratio = scrollTotal > 0 ? root.scrollTop / scrollTotal : 0;
      progress!.style.setProperty("--progress", `${ratio * 100}%`);

      // A TOC button is useful from the start; back to top only once scrolled.
      const isVisible = opensToc || ratio > 0.3;
      if (isVisible !== lastVisible) {
        fab!.toggleAttribute("data-visible", isVisible);
        lastVisible = isVisible;
      }
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    button.addEventListener("click", onButtonClick);
    document.addEventListener("click", onDocClick);
    popover?.addEventListener("toggle", onToggle);
    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    update();

    cleanup = () => {
      button.removeEventListener("click", onButtonClick);
      document.removeEventListener("click", onDocClick);
      popover?.removeEventListener("toggle", onToggle);
      removeEventListener("scroll", schedule);
      removeEventListener("resize", schedule);
      cancelAnimationFrame(frame);
    };
  }

  document.addEventListener("astro:page-load", initPostFab);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
