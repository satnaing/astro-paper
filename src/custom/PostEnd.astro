---
// Rendered on each post page, after the share links and before the
// previous/next links. Add comments, a newsletter form or an author bio
// here; use `post` to skip some posts. This file is yours: AstroPaper
// never changes it after release.
import type { CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"posts">;
};
